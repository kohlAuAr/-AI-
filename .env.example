# Copy to .env.local. Values are read by scripts/start-dev.ps1, not by Vite.
# Keep AI_MODE=local for the first run; no key or external model is required.
AI_MODE=local
AI_REDIS_ENABLED=false
# auto: LOCAL disables vectors, OPENAI uses the compatible API, OLLAMA uses native /api/embed.
# For recommendation only: AI_MODE=local, EMBEDDING_PROVIDER=ollama,
# EMBEDDING_BASE_URL=http://127.0.0.1:11434, EMBEDDING_MODEL=qwen3-embedding:0.6b.
# Ollama uses its native root URL, without /v1. No model auto-downloads.
# For real local RAG: AI_MODE=ollama, CHAT_BASE_URL=http://127.0.0.1:11434,
# CHAT_MODEL=qwen2.5:3b; use the same native embedding settings above.
EMBEDDING_PROVIDER=auto
CHAT_BASE_URL=http://127.0.0.1:11434/v1
CHAT_MODEL=
CHAT_API_KEY=
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
# Optional MySQL profile. Choose a local development password before starting compose.
# SPRING_PROFILES_ACTIVE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=13306
# DB_USER=campus
# DB_PASSWORD=replace-with-your-development-password
