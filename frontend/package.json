{
  "name": "campus-club-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test:prototype": "node scripts/test-prototype.mjs",
    "test:business": "node scripts/test-business.mjs",
    "test:ai-workflows": "node scripts/test-ai-workflows.mjs",
    "test:finance": "node scripts/test-finance.mjs",
    "test:finance:live": "node scripts/check-finance-live.mjs",
    "test:check-in": "node scripts/test-check-in.mjs",
    "test:check-in:live": "node scripts/check-check-in-live.mjs",
    "test:club-settings": "node scripts/test-club-settings.mjs",
