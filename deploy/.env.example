# Copy to deploy/.env. No passwords here; init-secrets.sh writes private files.
RELEASE=CHANGE_ME
HTTP_BIND=127.0.0.1
ADMIN_USERNAME=campus_admin
AI_MODEL_ALLOWED_URLS=https://api.example.invalid/v1
AI_REQUESTS_PER_MINUTE=5
AI_DAILY_ACCOUNT_LIMIT=50
AI_DAILY_PLATFORM_LIMIT=1000
AI_MAX_CONCURRENT_MODEL_REQUESTS=2
